      "start_line": 8035,
      "end_line": 8047
    },
    {
      "id": "2",
      "name": "After several transactions, the first ulCount = 1600 lppPhysical[0]:",
      "type": "section",
      "start_line": 8048,
      "end_line": 8059
    },
    {
      "id": "3",
      "name": "The first physical cash unit is ulCount = 600 lppPhysical[0]:",
      "type": "section",
      "start_line": 8060,
      "end_line": 8069
    },
    {
      "id": "4",
      "name": "A new cash unit is inserted ulCount = 900 lppPhysical[0]:",
      "type": "section",
      "start_line": 8070,
      "end_line": 8087
    },
    {
      "id": "11.1",
      "name": "One Physical Cash Unit Goes HIGH",
