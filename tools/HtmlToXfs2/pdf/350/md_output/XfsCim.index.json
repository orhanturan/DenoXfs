    },
    {
      "id": "11.3",
      "name": "One Physical Cash Unit Goes INOP",
      "type": "section",
      "start_line": 8125,
      "end_line": 8149
    },
    {
      "id": "11.4",
      "name": "Last Physical Cash Unit Goes FULL",
