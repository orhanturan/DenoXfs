<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DenoXfs.Sim.Data</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Npgsql asks only for EF Core 9.0.1; pin the EF version for every project that references this one. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.22" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.22">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Implements the core's stores (scenarios, device profiles, terminal selections). -->
    <ProjectReference Include="..\DenoXfsSimCore\DenoXfsSimCore.csproj" />
  </ItemGroup>

</Project>
