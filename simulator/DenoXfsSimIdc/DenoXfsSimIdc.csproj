<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DenoXfs.Sim.Idc</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The module brings its own web front end (page + minimal API endpoints). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\idc.html" LogicalName="DenoXfs.Sim.Idc.Web.idc.html" />
    <EmbeddedResource Include="Seeds\*.json" LogicalName="DenoXfs.Sim.Idc.Seeds.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DenoXfsSimCore\DenoXfsSimCore.csproj" />
    <ProjectReference Include="..\DenoXfsSimData\DenoXfsSimData.csproj" />
  </ItemGroup>

</Project>
